{
  "expo": {
    "name": "porcana",
    "slug": "porcana-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-black.png",
    "scheme": "com.porcana",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo/splash-icon-light.png",
      "resizeMode": "contain",
      "imageWidth": 200,
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/logo/splash-icon-dark.png",
        "backgroundColor": "#000000"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.porcana",
      "icon": {
        "light": "./assets/images/logo/ios-light.png",
        "dark": "./assets/images/logo/ios-dark.png"
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.265152231870-3c6ep7jleluv9eubu2k9nufr3hfv2nt6"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.265152231870-3c6ep7jleluv9eubu2k9nufr3hfv2nt6"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.porcana",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/adaptive-icon.png",
        "monochromeImage": "./assets/images/logo/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo-black.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-updates",
        {
          "handleMissingAppAfterUpdate": "warn"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/30a3c2c0-3d6f-4a36-ab42-31dab54ab6e5"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30a3c2c0-3d6f-4a36-ab42-31dab54ab6e5"
      }
    },
    "owner": "dwhddnjs"
  }
}
